{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "allowImportingTsExtensions": false
  },
  "include": ["src/index.ts", "src/components/system", "src/components/ui", "src/lib"],
  "exclude": ["src/components/__tests__", "src/components/stories", "src/test"]
}
